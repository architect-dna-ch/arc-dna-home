<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads how long and when each app is used. Granted by hand in Settings → Usage access. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Swipe down on home opens the notification panel. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Only for Einspruch and Anchor (they talk to their own servers). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates itself from its GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:icon="@drawable/ic_stats"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".StatsHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Can be picked as the home app: Settings → Apps → Default apps → Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EinspruchActivity"
            android:exported="false"
            android:label="Einspruch"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AnchorActivity"
            android:exported="false"
            android:label="Anchor"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MathActivity"
            android:exported="false"
            android:label="ARC Math"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
