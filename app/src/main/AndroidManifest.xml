<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Brightness lever: granted by the user under "Modify system settings". -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Xiaomi only: full-screen gestures with ARC-DNA as home (force_fsg_nav_bar). Never asked for;
         only granted by hand once: adb shell pm grant ch.architectdna.home android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates from the GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- "Zuletzt" row: granted by the user under Settings → Usage access, never automatically. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only for the optional head-nod scrolling; asked for when it is switched on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Head / eye scrolling in other apps runs as a camera foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- VOID FREQ keeps playing in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Music card: the audio visualizer reads the phone's output mix (Android files this under
         RECORD_AUDIO; nothing is recorded or stored). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Galerie: photos on the globe (Android 14+ also works with "only selected photos"). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Music card: the Bluetooth speaker's battery level ("Nearby devices"). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Bear alarm: exact daily alarm that rings over the lock screen and survives reboots. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Routen: snaps where you are to the nearest station to learn your usual routes (only on the phone). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Energie: do-not-disturb straight from its tile. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- ARC-DNA Telefon: place calls, show recent calls and contacts (read on the phone only). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Android 11+ package visibility: see every launchable app and the default apps for the dock. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- No backups or device transfer of the app's data (update token, history, favourites stay on this phone). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ARC-DNA"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Musik-Verlauf: the songs played, from the music card's stats page. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Musik-Verlauf" />

        <!-- ARC-DNA Telefon: the dialer in the launcher's style (the call itself runs in Android's in-call screen). -->
        <activity
            android:name=".DialerActivity"
            android:exported="true"
            android:label="ARC-DNA Telefon"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- VOID FREQ, native: its own app tile and task; the sound runs in FreqService. -->
        <activity
            android:name=".FreqActivity"
            android:exported="true"
            android:icon="@drawable/ic_voidfreq"
            android:label="VOID FREQ"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_voidfreq"
            android:taskAffinity="ch.architectdna.home.voidfreq"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rekorder: voice recordings, keeps recording with the screen off. -->
        <activity
            android:name=".RecorderActivity"
            android:exported="true"
            android:icon="@drawable/ic_recorder"
            android:label="Rekorder"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_recorder"
            android:taskAffinity="ch.architectdna.home.recorder"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ARC-DNA Kamera: thirds grid, a buddy coach with on-device hints, photos onto the Galerie globe. -->
        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:icon="@drawable/ic_arccam"
            android:label="ARC Kamera"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_arccam"
            android:taskAffinity="ch.architectdna.home.arccam"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dezibel: sound level meter (only the level, nothing is recorded). -->
        <activity
            android:name=".DecibelActivity"
            android:exported="true"
            android:icon="@drawable/ic_decibel"
            android:label="Dezibel"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_decibel"
            android:taskAffinity="ch.architectdna.home.decibel"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ARC Player: our own player screen for whatever plays (YouTube Music keeps playing underneath). -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:icon="@drawable/ic_player"
            android:label="ARC Player"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_player"
            android:taskAffinity="ch.architectdna.home.player"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Energie: drops down like a control centre: battery, switches, what drains. -->
        <activity
            android:name=".EnergyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_energy"
            android:label="Energie"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_energy"
            android:taskAffinity="ch.architectdna.home.energy"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN: ARC-DNA's face for Proton VPN (status, IP, country). -->
        <activity
            android:name=".VpnActivity"
            android:exported="true"
            android:icon="@drawable/ic_vpn"
            android:label="VPN"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_vpn"
            android:taskAffinity="ch.architectdna.home.vpn"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Routen: your usual public-transport routes on ARC-DNA's own map, with live trains. -->
        <activity
            android:name=".RouteActivity"
            android:exported="true"
            android:icon="@drawable/ic_routes"
            android:label="Routen"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_routes"
            android:taskAffinity="ch.architectdna.home.routes"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Galerie: photos on a globe, one region per month. -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:icon="@drawable/ic_gallery"
            android:label="Galerie"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_gallery"
            android:taskAffinity="ch.architectdna.home.gallery"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Whiteboard: boards with pseudo doctor titles ("Dr. Overloaded"). -->
        <activity
            android:name=".BoardActivity"
            android:exported="true"
            android:icon="@drawable/ic_board"
            android:label="Dr. Overloaded"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_board"
            android:taskAffinity="ch.architectdna.home.board"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Teilen → Dr. Overloaded": a picture (screenshot …) lands on the open whiteboard. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Kompass: anchors, own rules, parked doubts, money envelopes, pace & dose. -->
        <activity
            android:name=".KompassActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Kino mode: the popcorn microwave, full screen. -->
        <activity
            android:name=".PopcornActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Flexplan: calendar blocks that move with how you feel. -->
        <activity
            android:name=".PlanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Stimmung: mood log and patterns. -->
        <activity
            android:name=".MoodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- ARC-DNA Spielothek: darts, rocket, table tennis. -->
        <activity
            android:name=".SpielothekActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Gelassen: perspective, breathing and gratitude. -->
        <activity
            android:name=".CalmActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Pixel art in the wallpaper grid (the wallpaper shows through). -->
        <activity
            android:name=".PixelActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Wallpaper.NoTitleBar" />

        <!-- Pfeif- & Klavier-Lehrer (from the ARC-DNA apps). -->
        <activity
            android:name=".TuneActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Bär-Wecker: the daily bear alarm and one-time deadlines. -->
        <activity
            android:name=".WeckerActivity"
            android:exported="true"
            android:icon="@drawable/ic_alarm"
            android:label="Bär-Wecker"
            android:roundIcon="@drawable/ic_alarm"
            android:taskAffinity="ch.architectdna.home.wecker"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NEXUS BREACH: the arena wave shooter, native. -->
        <activity
            android:name=".NexusActivity"
            android:exported="true"
            android:icon="@drawable/ic_nexus"
            android:label="Nexus Breach"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_nexus"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="ch.architectdna.home.nexus"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Globus: links on a globe; also takes links shared from Chrome ("Teilen → Globus"). -->
        <activity
            android:name=".GlobusActivity"
            android:exported="true"
            android:icon="@drawable/ic_globus"
            android:label="Globus"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_globus"
            android:taskAffinity="ch.architectdna.home.globus"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Globus">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".FreqService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Bear alarm: full screen over the lock screen, its own task so Home stays the launcher. -->
        <activity
            android:name=".BearAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="ch.architectdna.home.alarm"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:turnScreenOn="true" />

        <!-- The ARC Player notification's buttons (only our own PendingIntents reach it). -->
        <receiver
            android:name=".ArcMediaNotice$Receiver"
            android:exported="false" />

        <!-- Not exported: only the system (boot, update) and our own alarm may reach it, no other app. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Flexplan live check-ins ("jetzt?") and their answers; re-armed after boot / update. -->
        <receiver
            android:name=".PlanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ARC-DNA Scroll: head / eye scrolling in apps chosen per app in the Mediathek. -->
        <service
            android:name=".ScrollAssistService"
            android:exported="true"
            android:foregroundServiceType="camera|microphone|location"
            android:label="ARC-DNA Scroll"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scroll_assist" />
        </service>

        <!-- ARC-DNA Live wallpaper: home + lock screen effects. -->
        <service
            android:name=".ArcWallpaper"
            android:exported="true"
            android:label="ARC-DNA Live"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/arc_wallpaper" />
        </service>

        <!-- Gives the music card access to the active media sessions (needs notification access). -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="ARC-DNA Musik"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
