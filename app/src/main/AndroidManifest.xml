<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Brightness lever: granted by the user under "Modify system settings". -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates from the GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Zuletzt" row: granted by the user under Settings → Usage access, never automatically. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only for the optional head-nod scrolling; asked for when it is switched on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Head / eye scrolling in other apps runs as a camera foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- VOID FREQ keeps playing in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Music card: the audio visualizer reads the phone's output mix (Android files this under
         RECORD_AUDIO; nothing is recorded or stored). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Galerie: photos on the globe (Android 14+ also works with "only selected photos"). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Music card: the Bluetooth speaker's battery level ("Nearby devices"). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Bear alarm: exact daily alarm that rings over the lock screen and survives reboots. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ARC-DNA Telefon: place calls, show recent calls and contacts (read on the phone only). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Android 11+ package visibility: see every launchable app and the default apps for the dock. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- No backups or device transfer of the app's data (update token, history, favourites stay on this phone). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ARC-DNA"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Musik-Verlauf: the songs played, from the music card's stats page. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Musik-Verlauf" />

        <!-- ARC-DNA Telefon: the dialer in the launcher's style (the call itself runs in Android's in-call screen). -->
        <activity
            android:name=".DialerActivity"
            android:exported="true"
            android:label="ARC-DNA Telefon"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- VOID FREQ, native: its own app tile and task; the sound runs in FreqService. -->
        <activity
            android:name=".FreqActivity"
            android:exported="true"
            android:icon="@drawable/ic_voidfreq"
            android:label="VOID FREQ"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_voidfreq"
            android:taskAffinity="ch.architectdna.home.voidfreq"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rekorder: voice recordings, keeps recording with the screen off. -->
        <activity
            android:name=".RecorderActivity"
            android:exported="true"
            android:icon="@drawable/ic_recorder"
            android:label="Rekorder"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_recorder"
            android:taskAffinity="ch.architectdna.home.recorder"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ARC-DNA Kamera: thirds grid, a buddy coach with on-device hints, photos onto the Galerie globe. -->
        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:icon="@drawable/ic_arccam"
            android:label="ARC Kamera"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_arccam"
            android:taskAffinity="ch.architectdna.home.arccam"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Galerie: photos on a globe, one region per month. -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:icon="@drawable/ic_gallery"
            android:label="Galerie"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_gallery"
            android:taskAffinity="ch.architectdna.home.gallery"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Whiteboard: boards with pseudo doctor titles ("Dr. Overloaded"). -->
        <activity
            android:name=".BoardActivity"
            android:exported="true"
            android:icon="@drawable/ic_board"
            android:label="Dr. Overloaded"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_board"
            android:taskAffinity="ch.architectdna.home.board"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NEXUS BREACH: the arena wave shooter, native. -->
        <activity
            android:name=".NexusActivity"
            android:exported="true"
            android:icon="@drawable/ic_nexus"
            android:label="Nexus Breach"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_nexus"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="ch.architectdna.home.nexus"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Globus: links on a globe; also takes links shared from Chrome ("Teilen → Globus"). -->
        <activity
            android:name=".GlobusActivity"
            android:exported="true"
            android:icon="@drawable/ic_globus"
            android:label="Globus"
            android:launchMode="singleTask"
            android:roundIcon="@drawable/ic_globus"
            android:taskAffinity="ch.architectdna.home.globus"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Globus">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".FreqService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Bear alarm: full screen over the lock screen, its own task so Home stays the launcher. -->
        <activity
            android:name=".BearAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="ch.architectdna.home.alarm"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:turnScreenOn="true" />

        <!-- Not exported: only the system (boot, update) and our own alarm may reach it, no other app. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ARC-DNA Scroll: head / eye scrolling in apps chosen per app in the Mediathek. -->
        <service
            android:name=".ScrollAssistService"
            android:exported="true"
            android:foregroundServiceType="camera"
            android:label="ARC-DNA Scroll"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scroll_assist" />
        </service>

        <!-- ARC-DNA Live wallpaper: home + lock screen effects. -->
        <service
            android:name=".ArcWallpaper"
            android:exported="true"
            android:label="ARC-DNA Live"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/arc_wallpaper" />
        </service>

        <!-- Gives the music card access to the active media sessions (needs notification access). -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="ARC-DNA Musik"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
