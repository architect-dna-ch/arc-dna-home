<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes tell which app is in front; taps and typing pause eye scrolling. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeViewLongClicked|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/scroll_assist_description"
    android:notificationTimeout="100" />
