<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates itself from the public ARC download mirror. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Siesta 90: a real alarm clock, and the phone quiet while you sleep -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <!-- the app search lists every launchable app -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- "Alle ARC-Werkzeuge öffnen" jumps into the ARC-DNA hub -->
        <package android:name="ch.architectdna.home" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_one"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Launcher Nr. 5: pick it under Settings → Apps → Default apps → Home app. -->
        <!-- Siesta 90: wakes you over the lock screen, gently -->
        <activity
            android:name=".SiestaWakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- ARC Guidebook: Quran and Sunnah explained, e-book style, with progress and a mind map -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="ARC Guidebook" />

        <!-- the goal as the paired phone/tablet has it, delivered by ARC-DNA over Bluetooth -->
        <receiver
            android:name=".GoalSync$In"
            android:exported="true" />

        <activity
            android:name=".OneHomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Teilen → ARC One" in YouTube Music sets your Music One track. -->
        <activity
            android:name=".MusicOneShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Music One"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
